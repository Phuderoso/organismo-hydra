; Arrr-bay AST. Language, not bytes.
node = {
  "op": verb / form,
  "args": [* node / value]
}

verb = "sit" / "fetch" / "map" / "hold" / "leave" / "ok"
     / "sha" / "open" / "forget" / "help" / "seq"
     / "say" / "cat" / "add" / "sub" / "eq" / "if"
     / "len" / "nth" / "not"
     / "err" / "get" / "has" / "keys" / "times" / "iserr" / "msg"
form = "str" / "int" / "kv" / "list" / "bytes"
value = text / int

; refuse (pin diary live-send extra host-attack) is not a node.
